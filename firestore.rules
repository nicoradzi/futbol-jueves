rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      // La app es pública para consultar jugadores, convocatorias, partidos y estadísticas.
      allow read: if true;
      // Solo cuentas autenticadas pueden modificar datos.
      allow write: if request.auth != null;
    }
  }
}